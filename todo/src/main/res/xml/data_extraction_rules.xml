<?xml version="1.0" encoding="utf-8"?>
<!-- Storage audited:
     database/todo-db        TodoDatabase (Todo): the user's task list.
     file/datastore_default.preferences_pb  app settings.
     sharedpref/secure_prefs  keystore-wrapped SQLCipher passphrase.

     Tasks are user-authored content worth restoring on a new device, so both
     channels carry the todo database. Caches and the keystore-bound passphrase
     are left out by the allowlist. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- Whole-domain include so the -wal/-shm sidecars travel with the database. -->
        <include domain="database" path="." />
        <include domain="file" path="datastore_default.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore_default.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
