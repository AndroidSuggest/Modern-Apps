<?xml version="1.0" encoding="utf-8"?>
<!--
  Unblock Jam. Audited state: two SharedPreferences files, "level_stats" and
  "daily_stats" (per LevelStatsRepository / AppBackupAgent.prefNames), holding
  level completion, stars and daily-challenge streaks. No Room database and no
  files written to filesDir or external storage — original_pack.json and
  achievements.json are read-only APK assets.

  Back everything up: level progress and streaks are precisely what a user
  expects to survive a new phone, and the whole payload is a few KB.

  SCOPE: unblockjam declares android:backupAgent=".util.AppBackupAgent" and does
  NOT set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's prefNames = ["level_stats", "daily_stats"], which is the same
  data this file would have sent. <device-transfer> IS governed here, and these
  rules become the cloud control too if the backupAgent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
