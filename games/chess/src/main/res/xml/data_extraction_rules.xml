<?xml version="1.0" encoding="utf-8"?>
<!--
  Chess. Audited state: everything the app persists lives in
  filesDir/datastore_default.preferences_pb (DataStoreUtils) — Learn-mode stars,
  achievements and game settings. No Room database, no files written to filesDir
  or external storage; puzzles.dat / learn.json / achievements.json are read-only
  APK assets. Stockfish's NNUE is read straight out of the APK.

  So: back everything up. Losing Learn progress on a phone migration is exactly
  the outcome these rules exist to prevent. Nothing here is large or personal
  enough to warrant an exclusion, and the platform already drops cacheDir and
  code_cache on its own.

  SCOPE: chess declares android:backupAgent=".util.AppBackupAgent" and does NOT
  set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's datastoreNames = ["datastore_default"], which is the same
  data this file would have sent. <device-transfer> IS governed here, and these
  rules become the cloud control too if the backupAgent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
