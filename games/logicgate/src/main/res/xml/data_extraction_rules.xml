<?xml version="1.0" encoding="utf-8"?>
<!--
  Logic Gate. Audited state: the "logicgate_stats" SharedPreferences file
  (ProgressRepository) plus filesDir/datastore_default.preferences_pb, which is
  where the user's saved circuits live (under the logicgate_circuits_v1 key —
  see the note in AppBackupAgent). No Room database, nothing on external
  storage; achievements.json is a read-only APK asset.

  Back everything up. Saved circuits are user-authored content, so dropping the
  file domain here would destroy real work.

  SCOPE: logicgate declares android:backupAgent=".util.AppBackupAgent" and does
  NOT set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's prefNames = ["logicgate_stats"] plus datastoreNames =
  ["datastore_default"] — so the saved circuits do reach the cloud, same as this
  file intends. <device-transfer> IS governed here, and these rules become the
  cloud control too if the backupAgent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
