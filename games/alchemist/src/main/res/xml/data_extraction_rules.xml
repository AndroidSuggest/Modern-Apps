<?xml version="1.0" encoding="utf-8"?>
<!--
  Alchemist. Audited state: filesDir/datastore_default.preferences_pb
  (DataStoreUtils) holding discovered combinations, achievements and settings.
  No Room database and no files written to filesDir or external storage;
  items.json and achievements.json are read-only APK assets.

  Back everything up. The discovery set is the entire game — it is small and
  irreplaceable.

  SCOPE: alchemist declares android:backupAgent=".util.AppBackupAgent" and does
  NOT set android:fullBackupOnly, so Android uses key/value backup and the
  <cloud-backup> section below is NOT consulted. Cloud content is exactly
  AppBackupAgent's datastoreNames = ["datastore_default"], which is the same
  data this file would have sent. <device-transfer> IS governed here, and these
  rules become the cloud control too if the backupAgent is ever removed.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
