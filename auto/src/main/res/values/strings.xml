<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Launcher and title. The product is a projection sender: it puts a driving-safe
         interface on the car's screen. -->
    <string name="app_name">Auto</string>

    <!-- Heading of the card showing whether a head unit is connected. -->
    <string name="connection">Connection</string>
    <!-- Shown when no head unit is attached, over USB or wirelessly. -->
    <string name="state_disconnected">Not connected to a car</string>
    <!-- Shown while the USB or wireless link is being brought up and authenticated. -->
    <string name="state_connecting">Connecting…</string>
    <!-- Shown once the car has authenticated and projection is running. %1$s is the car's
         name as it reported it, for example "Pioneer" or "Volkswagen". -->
    <string name="state_projecting">Projecting to <xliff:g example="Pioneer" id="car">%1$s</xliff:g></string>
    <!-- Shown when the link came up but the car refused to authenticate us. -->
    <string name="state_rejected">The car would not accept this phone</string>

    <!-- Explains that plugging in is all that is needed; there is nothing to configure. -->
    <string name="connect_hint">Plug the phone into the car with a USB cable, or start Android Auto from the car\'s screen if it supports a wireless connection.</string>

    <!-- Heading of the card showing what the projection session is doing. -->
    <string name="session_headline">Session</string>
    <!-- The video stream the head unit accepted. %1$d and %2$d are the width and height in
         pixels, %3$d the frame rate, %4$d the configuration index it chose. -->
    <string name="session_video">Video <xliff:g example="800" id="width">%1$d</xliff:g>×<xliff:g example="480" id="height">%2$d</xliff:g> @ <xliff:g example="30" id="fps">%3$d</xliff:g> fps, config <xliff:g example="0" id="config">%4$d</xliff:g></string>
    <!-- Shown when no video configuration has been accepted yet. -->
    <string name="session_video_none">No video yet</string>
    <!-- Heading of the row showing which side currently holds video focus. -->
    <string name="session_focus">Focus</string>
    <!-- Shown when no focus indication has arrived yet. -->
    <string name="session_focus_none">Unknown</string>
    <!-- Arbitrated video focus: the phone holds the screen and streams. -->
    <string name="session_focus_projected">Projected</string>
    <!-- Arbitrated video focus: the car holds the screen; the stream is parked. -->
    <string name="session_focus_native">Native</string>
    <!-- Heading of the row showing the raw 0x8008 wire mode for debugging. -->
    <string name="session_focus_wire">Wire focus</string>
    <!-- Heading of the row showing the last audio focus state the head unit reported. -->
    <string name="session_audio_focus">Audio focus</string>
    <!-- Heading of the row showing whether head-unit input may be injected. -->
    <string name="session_input_allowed">Input</string>
    <!-- Shown when head-unit touches and keys are injected into the car UI. -->
    <string name="session_input_allowed_yes">Allowed</string>
    <!-- Shown when head-unit input is held (native video, or projected without input focus). -->
    <string name="session_input_allowed_no">Held</string>
    <!-- Heading of the row showing encoded frames sent and head-unit acks seen. -->
    <string name="session_frames">Frames / acks</string>
    <!-- %1$d is frames sent, %2$d is acks seen. -->
    <string name="session_frames_value"><xliff:g example="120" id="frames">%1$d</xliff:g> / <xliff:g example="118" id="acks">%2$d</xliff:g></string>
    <!-- Heading of the row counting acks that named the wrong session. -->
    <string name="session_ack_mismatch">Ack mismatches</string>
    <!-- %1$d is the count of mismatched acks. -->
    <string name="session_ack_mismatch_value"><xliff:g example="1" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row showing the encode-side and ack rates over a sliding window.
         Sender-side only: sent frames per second and head-unit acks per second. -->
    <string name="session_rates">Rates sent / acked</string>
    <!-- %1$.1f is frames sent per second, %2$.1f is acks per second. -->
    <string name="session_rates_value"><xliff:g example="30.0" id="sent_fps">%1$.1f</xliff:g> / <xliff:g example="29.5" id="ack_fps">%2$.1f</xliff:g> fps</string>
    <!-- Heading of the row showing how old the last head-unit ack is. -->
    <string name="session_ack_age">Last ack</string>
    <!-- Shown once an ack has arrived. %1$s is an age like "0.4 s" or "12 s". -->
    <string name="session_ack_age_value"><xliff:g example="0.4 s" id="age">%1$s</xliff:g> ago</string>
    <!-- Age of the last head-unit ack under ten seconds, one decimal. %1$.1f is
         seconds; translators own the unit so it can be spaced or abbreviated per locale. -->
    <string name="session_ack_age_secs"><xliff:g example="0.4" id="secs">%1$.1f</xliff:g> s</string>
    <!-- Age of the last head-unit ack at ten seconds or more, whole seconds.
         %1$d is seconds; translators own the unit. -->
    <string name="session_ack_age_secs_whole"><xliff:g example="12" id="secs">%1$d</xliff:g> s</string>
    <!-- Shown on the session card before the first head-unit ack arrives. -->
    <string name="session_ack_age_none">No acks yet</string>
    <!-- Heading of the row showing the highest head-unit ack counter seen. -->
    <string name="session_ack_seq">Ack sequence</string>
    <!-- %1$d is the highest 0x8004 ack counter seen so far. -->
    <string name="session_ack_seq_value"><xliff:g example="118" id="seq">%1$d</xliff:g></string>
    <!-- Shown when no ack has carried a sequence counter yet. -->
    <string name="session_ack_seq_none">—</string>
    <!-- Heading of the row showing the mean encode-to-send latency. -->
    <string name="session_latency">Encode latency</string>
    <!-- %1$d is the rolling mean encode-to-send latency in microseconds. -->
    <string name="session_latency_value"><xliff:g example="8300" id="latency_us">%1$d</xliff:g> µs</string>
    <!-- Shown when no frame has been sent yet to measure latency from. -->
    <string name="session_latency_none">—</string>
    <!-- Heading of the row counting encoder drains. -->
    <string name="session_drains">Encoder drains</string>
    <!-- %1$d is the count of encoder drains so far. -->
    <string name="session_drains_value"><xliff:g example="240" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row showing whether the virtual display plus encoder input
         surface pair is currently up. -->
    <string name="session_surface">Surface</string>
    <!-- Shown on the session card while the virtual-display and encoder-input-surface
         pair is up and compositing. -->
    <string name="session_surface_valid">Valid</string>
    <!-- Shown on the session card when the render pair is down or not yet up. -->
    <string name="session_surface_invalid">Down</string>
    <!-- Heading of the row showing how long the GAL client certificate is still valid. -->
    <string name="session_credential">Certificate</string>
    <!-- Shown on the session card while the GAL leaf expiry has not been read yet,
         for example before the projection service starts. -->
    <string name="session_credential_unknown">Expiry unknown</string>
    <!-- Days of GAL leaf validity left, shown while comfortably far from expiry.
         %1$d is whole days remaining. -->
    <plurals name="session_credential_days">
        <item quantity="one"><xliff:g example="120" id="days">%1$d</xliff:g> day left</item>
        <item quantity="other"><xliff:g example="120" id="days">%1$d</xliff:g> days left</item>
    </plurals>
    <!-- Warning shown on the session card once the GAL leaf has 90 or fewer days left.
         %1$d is whole days remaining. -->
    <plurals name="session_credential_warning">
        <item quantity="one">Renew soon — <xliff:g example="45" id="days">%1$d</xliff:g> day left</item>
        <item quantity="other">Renew soon — <xliff:g example="45" id="days">%1$d</xliff:g> days left</item>
    </plurals>
    <!-- Urgent warning shown on the session card once the GAL leaf has 30 or fewer
         days left. %1$d is whole days remaining. -->
    <plurals name="session_credential_urgent">
        <item quantity="one">Expiring — <xliff:g example="12" id="days">%1$d</xliff:g> day left</item>
        <item quantity="other">Expiring — <xliff:g example="12" id="days">%1$d</xliff:g> days left</item>
    </plurals>
    <!-- Final warning shown on the session card in the last 7 days of GAL leaf
         validity. %1$d is whole days remaining. -->
    <plurals name="session_credential_critical">
        <item quantity="one">Expires in <xliff:g example="3" id="days">%1$d</xliff:g> day — re-extract the credential</item>
        <item quantity="other">Expires in <xliff:g example="3" id="days">%1$d</xliff:g> days — re-extract the credential</item>
    </plurals>
    <!-- Shown on the session card once the GAL leaf has expired. Projection stops
         working until the credential is rotated; see the handoff rotation runbook. -->
    <string name="session_credential_expired">Expired — projection needs a new credential</string>
    <!-- Heading of the row showing how long the session has been active. -->
    <string name="session_elapsed">Session time</string>
    <!-- Shown when there is no active session to time. -->
    <string name="session_elapsed_none">—</string>

    <!-- Heading of the card gating message mirroring. Both switches must be on
         before a notification reaches the car: the system listener binding and
         the in-app consent below. -->
    <string name="messaging_headline">Messages in the car</string>
    <!-- Explains what the card gates: which notifications leave the phone, and
         that replies typed or spoken in the car go back through the phone. -->
    <string name="messaging_body">Mirror message notifications to the car display and read them aloud. Replies you type or dictate in the car are sent from this phone.</string>
    <!-- Row toggling the in-app mirror switch. Mirroring stays off until this
         is on AND the system listener binding below is granted. -->
    <string name="messaging_consent">Mirror messages</string>
    <!-- Supporting text under the consent switch while mirroring is on. -->
    <string name="messaging_consent_on">Message notifications appear on the car display</string>
    <!-- Supporting text under the consent switch while mirroring is off. -->
    <string name="messaging_consent_off">Nothing leaves the phone until this is on</string>
    <!-- Row opening the system notification-access settings. -->
    <string name="messaging_listener">Notification access</string>
    <!-- Shown when the system listener binding is granted. -->
    <string name="messaging_listener_granted">Allowed — MA Auto can read message notifications</string>
    <!-- Shown when the system listener binding is not granted. -->
    <string name="messaging_listener_missing">Not allowed — open settings to let MA Auto read message notifications</string>
    <!-- Button opening the system notification-access settings. -->
    <string name="messaging_open_settings">Open settings</string>
    <!-- Heading of the row counting ch14 thread snapshots posted this session. -->
    <string name="session_messaging_threads">Message threads</string>
    <!-- %1$d is the count of thread snapshots posted. -->
    <string name="session_messaging_threads_value"><xliff:g example="3" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row counting ch14 message bodies posted this session. -->
    <string name="session_messaging_messages">Messages posted</string>
    <!-- %1$d is the count of message bodies posted. -->
    <string name="session_messaging_messages_value"><xliff:g example="5" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row counting head-unit replies received this session. -->
    <string name="session_messaging_replies">Car replies</string>
    <!-- %1$d is the count of replies received. -->
    <string name="session_messaging_replies_value"><xliff:g example="1" id="count">%1$d</xliff:g></string>

    <!-- Heading of the row counting ch8 touch frames injected this session. -->
    <string name="session_input_touches">Car touches</string>
    <!-- %1$d is the count of touch frames injected. -->
    <string name="session_input_touches_value"><xliff:g example="40" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row counting ch8 key presses/releases injected this session. -->
    <string name="session_input_keys">Car keys</string>
    <!-- %1$d is the count of keys injected. -->
    <string name="session_input_keys_value"><xliff:g example="7" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row counting ch8 scroll ticks injected this session. -->
    <string name="session_input_scrolls">Car scrolls</string>
    <!-- %1$d is the count of scroll ticks injected. -->
    <string name="session_input_scrolls_value"><xliff:g example="3" id="count">%1$d</xliff:g></string>
    <!-- Heading of the row counting ch8 reports dropped for lack of input focus. -->
    <string name="session_input_dropped">Input dropped</string>
    <!-- %1$d is the count of reports dropped without input focus. -->
    <string name="session_input_dropped_value"><xliff:g example="2" id="count">%1$d</xliff:g></string>

    <!-- Heading of the row showing what the on-device media session is playing. -->
    <string name="session_now_playing">Now playing</string>
    <!-- Shown on the session card before the media session has reported. -->
    <string name="session_now_playing_none">No media yet</string>
    <!-- Track and artist with playback state. %1$s is the track title, %2$s the
         artist, %3$s the state ("Playing" or "Paused" below). -->
    <string name="session_now_playing_value"><xliff:g example="Midnight City" id="title">%1$s</xliff:g> — <xliff:g example="M83" id="artist">%2$s</xliff:g> (<xliff:g example="Playing" id="state">%3$s</xliff:g>)</string>
    <!-- Playback state shown in the now-playing row and on the car now-playing card. -->
    <string name="session_now_playing_playing">Playing</string>
    <!-- Playback state shown in the now-playing row and on the car now-playing card. -->
    <string name="session_now_playing_paused">Paused</string>
    <!-- Shown when the media session reports no title. -->
    <string name="session_now_playing_unknown">Unknown track</string>
    <!-- Shown when the media session reports no artist. -->
    <string name="session_now_playing_unknown_artist">Unknown artist</string>

    <!-- Pairing screen: how the phone attaches to a car. -->
    <!-- Title of the pairing screen. -->
    <string name="pairing_title">Connect a car</string>
    <!-- Text on the button opening the pairing screen from the status card. -->
    <string name="pairing_open">Pairing</string>
    <!-- Explains that USB is plug-and-play and wireless needs the car screen. -->
    <string name="pairing_hint">Plug in with USB for the fastest setup, or look for cars to connect wirelessly. Wireless cars must support Android Auto over WiFi.</string>
    <!-- Heading of the row showing the USB cable state. -->
    <string name="pairing_usb">USB cable</string>
    <!-- Shown when no USB accessory is attached. -->
    <string name="pairing_usb_detached">No cable connected</string>
    <!-- Shown while waiting on the USB permission grant. %1$s is the accessory label. -->
    <string name="pairing_usb_permission">Waiting for permission %1$s</string>
    <!-- Shown when the USB permission was denied. -->
    <string name="pairing_usb_denied">Permission denied — the cable cannot be used</string>
    <!-- Button retrying the USB permission without replugging. -->
    <string name="pairing_usb_retry">Ask again</string>
    <!-- Shown once the USB accessory is open. %1$s is the accessory label. -->
    <string name="pairing_usb_connected">Connected %1$s</string>
    <!-- Shown when the USB accessory went away after having been seen. -->
    <string name="pairing_usb_lost">Cable disconnected</string>
    <!-- Heading of the row showing the wireless bring-up state. -->
    <string name="pairing_wireless">Wireless</string>
    <!-- Shown before wireless discovery starts. -->
    <string name="pairing_wireless_idle">Not looking for cars</string>
    <!-- Button starting WiFi Direct discovery. -->
    <string name="pairing_wireless_search">Look for cars</string>
    <!-- Shown while WiFi Direct discovery runs. -->
    <string name="pairing_wireless_searching">Looking for cars…</string>
    <!-- Shown once WiFi is negotiated and the socket is being opened. -->
    <string name="pairing_wireless_ready">Car found — connecting…</string>
    <!-- Button cancelling wireless discovery. -->
    <string name="pairing_wireless_cancel">Stop</string>
    <!-- Shown once the wireless socket is connected. -->
    <string name="pairing_wireless_connected">Connected wirelessly</string>
    <!-- Shown when wireless setup failed or the link dropped. -->
    <string name="pairing_wireless_lost">Wireless connection lost</string>
    <!-- Heading of the row showing which transport the session would use. -->
    <string name="pairing_transport">Active transport</string>
    <!-- Shown when USB won the transport selection. -->
    <string name="pairing_transport_usb">USB</string>
    <!-- Shown when wireless won the transport selection. -->
    <string name="pairing_transport_wireless">Wireless</string>
    <!-- Shown in dev builds when nothing else is up; never in release. -->
    <string name="pairing_transport_loopback">Developer loopback</string>
    <!-- Shown when no transport may be used yet. -->
    <string name="pairing_transport_none">None yet</string>
    <!-- Heading of the row showing the MAOS projection role. -->
    <string name="pairing_role">System role</string>
    <!-- Shown when this package holds SYSTEM_AUTOMOTIVE_PROJECTION. -->
    <string name="pairing_role_held">Projection role held — trusted display and input available</string>
    <!-- Shown on installs without the role; projection still works degraded. -->
    <string name="pairing_role_missing">No projection role — mirroring only, no trusted display</string>

    <!-- Notification channel name for the ongoing projection session. -->
    <string name="projection_channel">Projection</string>
    <!-- Ongoing notification shown while a car is connected. -->
    <string name="projection_running">Connected to a car</string>

    <!-- Second line of the car status bar, under the product name. -->
    <string name="car_connected">Connected</string>
    <!-- Heading of the single now-playing card on the car display (Phase 4 time-box). -->
    <string name="car_now_playing">Now playing</string>
    <!-- Shown on the car card while audio is playing. -->
    <string name="car_now_playing_playing">Playing</string>
    <!-- Shown on the car card while playback is paused. -->
    <string name="car_now_playing_paused">Paused</string>
    <!-- Shown on the car card when the media session reports no title. -->
    <string name="car_now_playing_unknown">Unknown track</string>
    <!-- Shown on the car card when the media session reports no artist. -->
    <string name="car_now_playing_unknown_artist">Unknown artist</string>
    <!-- Shown on the car display when no launchable apps were found on the phone. -->
    <string name="car_no_apps">No apps available — install Maps or Music to get started</string>
    <!-- Label of the hotseat drawer cell and the drawer heading listing every car app. -->
    <string name="car_drawer_apps">Apps</string>
    <!-- Decorative glyph shown on the hotseat drawer cell, which has no app icon. -->
    <string name="car_drawer_glyph">▦</string>
    <!-- Decorative glyph on the facet dashboard button (goes home, closes drawer). -->
    <string name="car_home_glyph">⌂</string>

    <!-- Heading of the session-card row showing the system sink (ch4, transient TTS/pings). -->
    <string name="session_audio_sys">System audio</string>
    <!-- Heading of the session-card row showing the media sink (ch5, music). -->
    <string name="session_audio_media">Media audio</string>
    <!-- Shown for a sink whose channel has not opened yet this session. -->
    <string name="session_audio_sink_none">No channel yet</string>
    <!-- Shown for a sink whose discovery cannot carry PCM (non-PCM codec or no sane
         config); the sink is parked, never started. -->
    <string name="session_audio_sink_unsupported">Unsupported — parked</string>
    <!-- Shown for a sink that claimed its channel but has not started streaming. -->
    <string name="session_audio_sink_idle">Idle</string>
    <!-- Shown for a streaming sink. %1$s is the arbitrated gain ("Full", "Ducked"). -->
    <string name="session_audio_sink_streaming">Streaming (<xliff:g example="Full" id="gain">%1$s</xliff:g>)</string>
    <!-- Heading of the session-card row counting PCM bytes framed out on ch4/5. -->
    <string name="session_audio_bytes">Audio bytes</string>
    <!-- %1$d is PCM bytes framed out this session. -->
    <string name="session_audio_bytes_value"><xliff:g example="48000" id="bytes">%1$d</xliff:g></string>
    <!-- Heading of the session-card row counting music PCM captured into ch5. -->
    <string name="session_audio_music_captured">Music captured</string>
    <!-- %1$d is music PCM bytes captured into the ch5 sink this session. -->
    <string name="session_audio_music_captured_value"><xliff:g example="48000" id="bytes">%1$d</xliff:g></string>

    <!-- Heading of the card gating car music. Both switches must be on before
         phone audio reaches the head unit: the in-app consent below and the
         system media-projection grant. -->
    <string name="music_capture_headline">Music in the car</string>
    <!-- Explains what the card gates: phone media audio leaves for the car
         speakers only while consented and granted; otherwise it stays local. -->
    <string name="music_capture_body">Send phone music to the car speakers while projecting. The phone stays quiet for music while capture runs; without both switches below, music plays on the phone as before.</string>
    <!-- Row toggling the in-app music-capture switch. Capture stays off until
         this is on AND the system projection grant below is granted. -->
    <string name="music_capture_consent">Send music to the car</string>
    <!-- Supporting text under the consent switch while capture is on. -->
    <string name="music_capture_consent_on">Music plays on the car speakers while projecting</string>
    <!-- Supporting text under the consent switch while capture is off. -->
    <string name="music_capture_consent_off">Music stays on the phone until this is on</string>
    <!-- Row opening the system media-projection consent dialog. -->
    <string name="music_capture_projection">Screen-cast permission</string>
    <!-- Shown when the system media-projection grant is stored. -->
    <string name="music_capture_projection_granted">Allowed — MA Auto can capture media audio</string>
    <!-- Shown when the system media-projection grant is not stored. -->
    <string name="music_capture_projection_missing">Not allowed — grant permission to send music to the car</string>
    <!-- Button launching the system media-projection consent dialog. -->
    <string name="music_capture_allow">Allow</string>
    <!-- Snackbar when the media-projection consent dialog is denied or fails. -->
    <string name="music_capture_denied">Permission denied — music stays on the phone</string>
    <!-- Ongoing notification while music capture runs (its own service holds
         the media-projection token; %1$s is the product name). -->
    <string name="music_capture_notification">Sending music to the car</string>
    <!-- Heading of the session-card row counting ch6 mic turns and acks. -->
    <string name="session_audio_mic">Car mic</string>
    <!-- %1$d is mic turns that yielded PCM, %2$d is chunks acked upstream. -->
    <string name="session_audio_mic_value"><xliff:g example="2" id="turns">%1$d</xliff:g> turns / <xliff:g example="140" id="acks">%2$d</xliff:g> acked</string>
    <!-- Heading of the session-card row counting TTS utterances that reached the car. -->
    <string name="session_audio_tts">Car TTS</string>
    <!-- %1$d is utterances spoken on the car speakers this session. -->
    <string name="session_audio_tts_value"><xliff:g example="3" id="count">%1$d</xliff:g></string>

    <!-- Heading of the card gating car-mic voice retention on the microphone permission. -->
    <string name="mic_headline">Car microphone</string>
    <!-- Explains that the mic channel acks regardless, but keeping a voice turn
         needs the grant; without it the phone retains nothing. -->
    <string name="mic_body">The car microphone streams through this phone during voice replies. Allowing microphone access lets MA Auto keep a reply turn for transcription; without it, turns are acknowledged but never stored.</string>
    <!-- Row showing the microphone permission state. -->
    <string name="mic_permission">Microphone access</string>
    <!-- Shown when the microphone permission is granted. -->
    <string name="mic_permission_granted">Allowed — voice replies can be transcribed</string>
    <!-- Shown when the microphone permission is not granted. -->
    <string name="mic_permission_missing">Not allowed — voice replies are acknowledged but not kept</string>
    <!-- Button requesting the microphone permission. -->
    <string name="mic_allow">Allow</string>

    <!-- Content description of the rail assistant slot. Shown only when the phone
         has an assistant to open; otherwise the slot stays gone. -->
    <string name="car_assistant_label">Assistant</string>
    <!-- Decorative glyph on the rail assistant icon, which has no app icon of its own. -->
    <string name="car_assistant_glyph">◉</string>
    <!-- Decorative glyph on the native-rail back button. -->
    <string name="car_back_glyph">←</string>
    <!-- Content description of the native-rail back button. -->
    <string name="car_back_label">Back</string>
    <!-- Decorative glyph on the native-rail exit button. -->
    <string name="car_exit_glyph">✕</string>
    <!-- Decorative glyph standing in for the rail etc affordance icon. -->
    <string name="car_etc_glyph">⋯</string>
    <!-- Content description of the media card previous-track button. -->
    <string name="car_media_previous">Previous</string>
    <!-- Content description of the media card next-track button. -->
    <string name="car_media_next">Next</string>
    <!-- Content description of the media card play button, shown while paused. -->
    <string name="car_media_play">Play</string>
    <!-- Content description of the media card pause button, shown while playing. -->
    <string name="car_media_pause">Pause</string>
    <!-- Decorative glyph on the media card previous-track button. -->
    <string name="car_media_prev_glyph">⏮</string>
    <!-- Decorative glyph on the media card next-track button. -->
    <string name="car_media_next_glyph">⏭</string>
    <!-- Decorative glyph on the media card play button, shown while paused. -->
    <string name="car_media_play_glyph">▶</string>
    <!-- Decorative glyph on the media card pause button, shown while playing. -->
    <string name="car_media_pause_glyph">⏸</string>
    <!-- Distance to the next maneuver on the nav card. %1$d is whole metres;
