<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- Flag hardcoded UI strings as warnings -->
    <issue id="HardcodedText" severity="warning" />

    <!-- Empty translation skeletons for Weblate - informational only -->
    <issue id="MissingTranslation" severity="informational" />

    <!-- Timber is not a dependency anywhere in this repo; the apps log through
         android.util.Log on purpose. Adopting a logging library to satisfy a
         lint check would be the wrong way round. -->
    <issue id="LogNotTimber" severity="ignore" />

    <!-- Symbolic / single-char Text() usages that are legitimate -->
    <!-- We filter those in the verification script; lint may still flag them -->
</lint>
