<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name. Shown in Settings > Safety & emergency and app info; no launcher entry. -->
    <string name="app_name">Emergency</string>

    <!-- One-line summary under the Settings > Safety & emergency row when nothing is set. -->
    <string name="injection_summary_empty">Add emergency contacts and medical information</string>
    <!-- Settings suggestion: title shown to first-run users. -->
    <string name="settings_suggestion_title">Add emergency information</string>
    <!-- Settings suggestion: explanation shown to first-run users. -->
    <string name="settings_suggestion_body">First responders can see it from the lock screen in an emergency.</string>

    <!-- View screen: tab showing the owner's medical details. Noun. -->
    <string name="tab_title_info">Info</string>
    <!-- View screen: tab showing the emergency contacts. Noun. -->
    <string name="tab_title_contacts">Contacts</string>
    <!-- View screen: heading above the owner's name and address cards. Noun. -->
    <string name="group_owner">Owner</string>
    <!-- View screen: heading above each emergency contact's name and number cards. Noun phrase. -->
    <string name="group_emergency_contact">Emergency Contact</string>
    <!-- View screen: heading above the allergies group. Noun. -->
    <string name="section_allergies">Allergies</string>
    <!-- View screen: heading above the conditions group. Noun. -->
    <string name="section_conditions">Conditions</string>
    <!-- View screen: heading above the medications group. Noun. -->
    <string name="section_medications">Medications</string>
    <!-- View screen: shown when neither medical info nor contacts are set. -->
    <string name="no_info">No emergency information provided.</string>

    <!-- Edit screen: address row. Noun. -->
    <string name="field_address">Address</string>
    <!-- Edit screen: heading above the owner's picked identity. Noun phrase. -->
    <string name="section_owner_identity">Your identity</string>
    <!-- Edit screen: row that opens the contact picker for the owner's identity. Verb phrase. -->
    <string name="choose_owner_contact">Choose your contact</string>
    <!-- Edit screen: hint shown when no owner contact has been picked yet. -->
    <string name="owner_identity_empty">Pick your contact to fill in your name and address.</string>
    <!-- Address chooser: title asking which of the picked contact's addresses to use. Has the contact's name as its argument. -->
    <string name="owner_address_chooser_title">Which address for <xliff:g id="name" example="Sam Rivera">%1$s</xliff:g>?</string>
    <!-- Edit screen: shown when the picked owner contact could not be read. -->
    <string name="fail_pick_owner">Could not read that contact.</string>
    <!-- Edit screen: blood-type row. Noun phrase. -->
    <string name="field_blood_type">Blood type</string>
    <!-- Edit screen: organ-donor row. Noun phrase. -->
    <string name="field_organ_donor">Organ donor</string>
    <!-- Edit screen: heading above the contact list. Noun phrase. -->
    <string name="section_emergency_contacts">Emergency contacts</string>
    <!-- Edit screen: row that opens the contact picker. Verb phrase. -->
    <string name="add_emergency_contact">Add emergency contact</string>
    <!-- Edit screen: shown when adding a contact whose number can no longer be read. -->
    <string name="fail_add_contact">Could not add that contact.</string>
    <!-- Edit screen: heading above the Health Connect connect prompt. Noun phrase. -->
    <string name="section_medical_info">Medical information</string>
    <!-- Contact row: button that removes the contact. Verb. -->
    <string name="remove_contact">Remove</string>
    <!-- Contact row: button that opens the contact. Verb. -->
    <string name="view_contact">View</string>

    <!-- Contacts permission: title of the prompt shown before the contact list. -->
    <string name="contacts_permission_title">Contacts access is off</string>
    <!-- Contacts permission: explanation shown before the contact list. -->
    <string name="contacts_permission_hint">Allow Emergency to read contacts to choose who to call for you.</string>
    <!-- Contacts permission: button that requests the permission. Verb phrase. -->
    <string name="contacts_permission_action">Allow contacts access</string>

    <!-- SOS: title of the countdown screen and its notification channel. Noun phrase. -->
    <string name="sos_title">Emergency SOS</string>
    <!-- SOS: countdown subtitle naming the number about to be dialled. Has the number as its argument. -->
    <string name="sos_subtitle">Calling <xliff:g id="number" example="911">%1$s</xliff:g> in <xliff:g id="seconds" example="5">%2$d</xliff:g></string>
    <!-- SOS: slide-to-cancel control. Verb. -->
    <string name="sos_cancel">Cancel</string>
    <!-- SOS: notification text while counting down. Has the number as its argument. -->
    <string name="sos_notification_text">Emergency SOS: calling <xliff:g id="number" example="911">%1$s</xliff:g></string>
    <!-- Notifications: channel for the SOS countdown. Noun phrase. -->
    <string name="sos_channel_name">Emergency SOS</string>
    <!-- Notifications: channel description. -->
    <string name="sos_channel_description">Countdown before an emergency SOS call is placed.</string>
    <!-- SOS: shown when the gesture is not enabled and the screen is opened directly. -->
    <string name="sos_not_enabled">Emergency SOS is not turned on.</string>

    <!-- Shown in place of the contact list while contacts are still being read. -->
    <string name="contacts_loading">Loading contacts…</string>

    <!-- View screen: heading above current medications read from Health Connect. Noun phrase. -->
    <string name="section_current_medications">Medications</string>
    <!-- Attribution shown under the Health Connect sections. -->
    <string name="from_health_connect">From Health Connect</string>
    <!-- Allergy criticality shown as a trailing label on high-severity allergies. Noun phrase. -->
    <string name="allergy_high">Severe</string>
    <!-- Allergy criticality shown as a trailing label on low-severity allergies. Noun. -->
    <string name="allergy_low">Mild</string>
    <!-- Edit screen: row that grants Health Connect access to import allergies and medications. Verb phrase. -->
    <string name="health_connect_connect">Import from Health Connect</string>
    <!-- Edit screen: shown once Health Connect access has been granted. Statement. -->
    <string name="health_connect_connected">Connected to Health Connect</string>
    <!-- Edit screen: explanation under the Health Connect import row. -->
    <string name="health_connect_hint">Show your allergies and current medications from Health Connect on the emergency card.</string>

    <!-- Dialog button that stores the chosen value. Verb. -->
    <string name="save">Save</string>
    <!-- Dialog button that discards the change. Verb. -->
    <string name="cancel">Cancel</string>
</resources>
