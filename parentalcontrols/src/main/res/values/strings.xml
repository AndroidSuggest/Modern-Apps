<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name. Shown in app info and in Settings' list of supervision apps; there is still no launcher entry. -->
    <string name="app_name">Parental Controls</string>

    <!-- Dashboard: title of the top-level parental-controls screen. Noun phrase. -->
    <string name="dashboard_title">Parental controls</string>
    <!-- Dashboard: the master on/off switch for all controls on this device. Noun phrase. -->
    <string name="controls_for_this_phone">Controls for this phone</string>
    <!-- Dashboard: row that opens the web content filters. Noun phrase. -->
    <string name="dashboard_web_filters">Web content filters</string>
    <!-- Dashboard: row that opens PIN management. Verb phrase. -->
    <string name="dashboard_manage_pin">Manage your PIN</string>
    <!-- Dashboard: summary for a control that is turned off. Adjective. -->
    <string name="summary_off">Off</string>
    <!-- Dashboard: summary for a limit with no value set. Verb phrase. -->
    <string name="summary_not_set">Not set</string>
    <!-- Dashboard: summary under App limits when at least one app is capped. Statement. -->
    <string name="summary_app_limits_set">App limits set</string>
    <!-- Dashboard: summary under App limits when none are capped. Statement. -->
    <string name="summary_no_app_limits">No app limits</string>
    <!-- Dashboard: summary under Web content filters. Statement. -->
    <string name="summary_web_filters">Filtering explicit sites &amp; search results</string>

    <!-- Web content filters screen: title. Noun phrase. -->
    <string name="web_filters_title">Web content filters</string>
    <!-- Web content filters screen: the on/off toggle. Verb phrase. -->
    <string name="web_filters_toggle">Filter explicit sites</string>
    <!-- Web content filters screen: explanation under the toggle. -->
    <string name="web_filters_toggle_hint">Blur explicit sites and turn on SafeSearch in supported browsers.</string>

    <!-- Bedtime screen: title, also the label of its row in Settings > Parental controls. Noun phrase. -->
    <string name="bedtime_title">Child bedtime</string>
    <!-- One-line summary under the Child bedtime row in Settings. -->
    <string name="bedtime_summary">Parental schedule: chosen apps stay closed overnight</string>
    <!-- Bedtime screen: the main on/off switch. Verb phrase. -->
    <string name="bedtime_enable">Use a bedtime schedule</string>
    <!-- Bedtime screen: explanation under the main switch. -->
    <string name="bedtime_enable_hint">The apps you choose below cannot be opened during the hours you set.</string>
    <!-- Bedtime screen: row for the time the window opens. Noun phrase. -->
    <string name="bedtime_start">Starts at</string>
    <!-- Bedtime screen: row for the time the window closes. Noun phrase. -->
    <string name="bedtime_end">Ends at</string>
    <!-- Bedtime screen: heading above the day-of-week chips. Noun. -->
    <string name="bedtime_days">Days</string>
    <!-- Bedtime screen: heading above the list of apps the schedule covers. Noun. -->
    <string name="bedtime_apps">Apps</string>
    <!-- Bedtime screen: single-letter labels for the seven day chips, Monday first, comma separated. -->
    <string name="bedtime_day_initials">M,T,W,T,F,S,S</string>

    <!-- App limits screen: title, also the label of its row in Settings > Parental controls. Noun phrase. -->
    <string name="limits_title">App limits</string>
    <!-- One-line summary under the App limits row in Settings. -->
    <string name="limits_summary">Set how long each app can be used per day</string>
    <!-- App limits screen: heading of the explanatory row. Noun phrase. -->
    <string name="limits_explainer">Daily time limits</string>
    <!-- App limits screen: explanation of when a limit takes effect and when it resets. -->
    <string name="limits_explainer_hint">An app stops opening once its time is used up, and becomes available again at midnight.</string>
    <!-- App limits screen: shown for an app with no limit set, and as the option that removes one. -->
    <string name="limits_none">No limit</string>

    <!-- Shown in place of the app list while installed apps are still being read. -->
    <string name="apps_loading">Loading apps…</string>

    <!-- PIN challenge: title of the gate shown before any parent-only surface. Noun phrase. -->
    <string name="pin_title">Parent PIN</string>
    <!-- PIN challenge: explanation of why the PIN is asked. -->
    <string name="pin_challenge_hint">Enter the parent PIN to change these settings.</string>
    <!-- PIN challenge: label of the PIN entry field. Noun. -->
    <string name="pin_label">PIN</string>
    <!-- PIN challenge: button that submits the entered PIN. Verb. -->
    <string name="pin_unlock">Unlock</string>
    <!-- PIN challenge: shown after a wrong entry while attempts remain. -->
    <string name="pin_wrong">Wrong PIN. Try again.</string>
    <!-- PIN challenge: shown while brute-force lockout is active. -->
    <string name="pin_locked_out">Too many tries. Try again later.</string>

    <!-- PIN setup: title of first-run creation and later change. Noun phrase. -->
    <string name="pin_setup_title">Set parent PIN</string>
    <!-- PIN setup: explanation shown above the two entry fields. -->
    <string name="pin_setup_hint">Choose a PIN only a parent knows. It protects every limit, schedule and bonus.</string>
    <!-- PIN setup: label of the first entry field. Noun phrase. -->
    <string name="pin_new_label">New PIN</string>
    <!-- PIN setup: label of the repeat field. Noun phrase. -->
    <string name="pin_confirm_label">Repeat PIN</string>
    <!-- PIN setup: shown under the repeat field when the two entries differ. -->
    <string name="pin_mismatch">PINs do not match.</string>
    <!-- PIN setup: confirmation shown after the PIN is stored. -->
    <string name="pin_saved">Parent PIN saved.</string>

    <!-- Lock screens: title shown for each block reason. Noun phrases. -->
    <string name="lock_bedtime_title">Bedtime</string>
    <string name="lock_downtime_title">Downtime</string>
    <string name="lock_school_title">School time</string>
    <string name="lock_daily_title">Daily limit reached</string>
    <string name="lock_applimit_title">App limit reached</string>
    <!-- Lock screens: explanation under each title. -->
    <string name="lock_bedtime_hint">This app is unavailable during bedtime hours.</string>
    <string name="lock_downtime_hint">This app is unavailable during downtime. Only approved apps can be opened.</string>
    <string name="lock_school_hint">This app is unavailable during school hours. Only learning apps can be opened.</string>
    <string name="lock_daily_hint">Today\'s screen-time budget is used up. Everything unlocks again at midnight.</string>
    <string name="lock_applimit_hint">This app\'s time for today is used up. It unlocks again at midnight.</string>
    <!-- Lock screens: button that starts the parent-PIN bonus flow. Verb phrase. -->
    <string name="lock_ask_parent">Ask a parent for more time</string>
    <!-- Lock screens: button that dismisses the notice. Verb. -->
    <string name="lock_close">OK</string>
    <!-- Notifications: channel for restriction notices. Noun phrase. -->
    <string name="lock_channel_name">Restrictions</string>
    <!-- Notifications: channel description. -->
    <string name="lock_channel_description">Notices when bedtime, downtime, school time or a limit blocks an app.</string>

    <!-- Downtime screen: title, also the label of its row in Settings > Parental controls. Noun. -->
    <string name="downtime_title">Downtime</string>
    <!-- One-line summary under the Downtime row in Settings. -->
    <string name="downtime_summary">Choose hours when only approved apps open</string>
    <!-- Downtime screen: the main on/off switch. Verb phrase. -->
    <string name="downtime_enable">Use a downtime schedule</string>
    <!-- Downtime screen: explanation under the main switch. -->
    <string name="downtime_enable_hint">Everything except the apps you approve below stays closed during the hours you set.</string>
    <!-- Downtime screen: row for the time the window opens. Noun phrase. -->
    <string name="downtime_start">Starts at</string>
    <!-- Downtime screen: row for the time the window closes. Noun phrase. -->
    <string name="downtime_end">Ends at</string>
    <!-- Downtime screen: heading above the day-of-week chips. Noun. -->
    <string name="downtime_days">Days</string>
    <!-- Downtime screen: heading above the list of apps that stay available. Noun phrase. -->
    <string name="downtime_apps">Approved apps</string>

    <!-- School time screen: title, also the label of its row in Settings > Parental controls. Noun phrase. -->
    <string name="school_title">School time</string>
    <!-- One-line summary under the School time row in Settings. -->
    <string name="school_summary">Limit the device to learning apps during school</string>
    <!-- School time screen: the main on/off switch. Verb phrase. -->
    <string name="school_enable">Use a school time schedule</string>
    <!-- School time screen: explanation under the main switch. -->
    <string name="school_enable_hint">Only the learning apps you approve below can be opened during school hours.</string>
    <!-- School time screen: row for the time the window opens. Noun phrase. -->
    <string name="school_start">Starts at</string>
    <!-- School time screen: row for the time the window closes. Noun phrase. -->
    <string name="school_end">Ends at</string>
    <!-- School time screen: heading above the day-of-week chips. Noun. -->
    <string name="school_days">Days</string>
    <!-- School time screen: heading above the list of learning apps. Noun phrase. -->
    <string name="school_apps">Learning apps</string>

    <!-- Daily limit screen: title, also the label of its row in Settings > Parental controls. Noun phrase. -->
    <string name="daily_title">Daily limit</string>
    <!-- One-line summary under the Daily limit row in Settings. -->
    <string name="daily_summary">Set total screen time allowed per day</string>
    <!-- Daily limit screen: heading of the explanatory row. Noun phrase. -->
    <string name="daily_explainer">Whole-device time budget</string>
    <!-- Daily limit screen: explanation of when the budget takes effect and resets. -->
    <string name="daily_explainer_hint">Everything locks once the day\'s budget is used up, and unlocks again at midnight.</string>
    <!-- Daily limit screen: row showing the current budget. Noun phrase. -->
    <string name="daily_budget">Daily budget</string>

    <!-- Dialog button that stores the chosen value. Verb. -->
    <string name="save">Save</string>
    <!-- Dialog button that discards the change. Verb. -->
    <string name="cancel">Cancel</string>
</resources>
