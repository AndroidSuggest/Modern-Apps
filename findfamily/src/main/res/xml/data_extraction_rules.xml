<?xml version="1.0" encoding="utf-8"?>
<!-- Overrides the permissive default in the shared :library module.

     Storage audited:
       database/passwords-db  FFDatabase (User/Waypoint/LocationValue/TemporaryLink):
                              precise location history and family link state.
       file/datastore_default.preferences_pb  userid plus the E2EE identity keypair and
                              the "ff_pqc" post-quantum keys (Networking.init ->
                              E2eeIdentity/PqcIdentity.loadOrCreate). Private key material.
       sharedpref/secure_prefs  keystore-wrapped SQLCipher passphrase.

     Nothing leaves for cloud backup: location history is sensitive and the DataStore
     holds long-term private keys. Device transfer carries the location history only;
     the key material stays on the device that generated it, so a new device
     re-establishes its own identity and family links. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Allowlist: the database domain only, so the DataStore holding the E2EE and
             PQC private keys is excluded. Whole-domain include keeps the -wal/-shm
             sidecars with the database. -->
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
