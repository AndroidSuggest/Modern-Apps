root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{xml,gradle}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
