<?xml version="1.0" encoding="utf-8"?>
<!-- Deny-all, matching the app's android:allowBackup="false". App state includes recent
     pickup/dropoff locations, which are precise location history and must not be copied
     off-device. Overrides the permissive default in the shared :library module. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
