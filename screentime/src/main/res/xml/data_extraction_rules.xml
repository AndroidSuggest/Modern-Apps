<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!--
      Nothing to carry. Timers, focus profiles and wind-down schedules are device-local
      configuration, and usage history is recomputed from UsageStats on demand.
      `allowBackup="false"` in the manifest already says so; this file exists
      because the manifest references it.
    -->
    <cloud-backup />
    <device-transfer />
</data-extraction-rules>
