<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name. Shown in the launcher and app info. -->
    <string name="app_name">Screen Time</string>

    <!-- Wind-down: title, also the label of its Settings row. Noun phrase. -->
    <string name="winddown_title">Wind Down</string>
    <!-- One-line summary under the Bedtime row in Settings. -->
    <string name="winddown_summary">Grayscale and Do Not Disturb overnight</string>

    <!-- Details: usage section heading. Noun. -->
    <string name="details_usage">Usage</string>
    <!-- Per-app details: title of the drill-down screen. Noun phrase. -->
    <string name="details_title">Time spent</string>
    <!-- Details: timer row. Noun. -->
    <string name="details_timer">Timer</string>
    <!-- Details: pause section heading. Noun. -->
    <string name="details_pause_title">Pause</string>
    <!-- Details: pause row. Verb phrase. -->
    <string name="details_pause_app">Pause this app</string>
    <!-- Details: explanation under the pause row. -->
    <string name="details_pause_app_hint">Pausing blocks the app right away. Turn it back on here to unpause.</string>
    <!-- Details: shown when no package was supplied. -->
    <string name="details_no_app">Pick an app from the dashboard to see its details.</string>

    <!-- Friction: mindful-nudge title. Noun phrase. -->
    <string name="friction_nudge_title">Still want this?</string>
    <!-- Friction: nudge explanation. -->
    <string name="friction_nudge_hint">You asked for a reminder when you open this app a lot. Take a breath first.</string>
    <!-- Friction: spent-timer title. Noun phrase. -->
    <string name="friction_spent_title">Time\'s up</string>
    <!-- Friction: spent explanation. -->
    <string name="friction_spent_hint">This app\'s timer ran out. It stays paused until midnight.</string>
    <!-- Friction: break button. Verb phrase. -->
    <string name="friction_break">Take a break</string>
    <!-- Friction: nudge continue button. Verb. -->
    <string name="friction_continue">Continue</string>
    <!-- Friction: spent continue button. Verb phrase. -->
    <string name="friction_open_anyway">Open anyway</string>

    <!-- Widget: description shown in the picker. -->
    <string name="widget_description">Today\'s screen time at a glance.</string>
    <!-- Widget: heading above the total. Noun phrase. -->
    <string name="widget_today">Today</string>

    <!-- Dashboard: one-line summary under the Screen Time row in Settings. -->
    <string name="dashboard_summary">Today\'s total and per-app usage, with timers</string>

    <!-- Dashboard: week/day chart toggle. Noun. -->
    <string name="period_week">Week</string>
    <!-- Dashboard: week/day chart toggle. Noun. -->
    <string name="period_day">Day</string>
    <!-- Dashboard: label above the total-time figure. Noun phrase. -->
    <string name="stat_total">Total screen time</string>
    <!-- Dashboard: label above the per-day average (week view). Noun phrase. -->
    <string name="stat_daily_average">Daily average</string>
    <!-- Dashboard: label above the per-hour average (day view). Noun phrase. -->
    <string name="stat_hourly_average">Hourly average</string>
    <!-- Dashboard: shown above the date when the day view is on today. Noun. -->
    <string name="range_today">Today</string>
    <!-- Dashboard: title of the usage-access prompt shown when the usage-stats op is denied. -->
    <string name="dashboard_no_access_title">Usage access is off</string>
    <!-- Dashboard: explanation under the usage-access prompt. -->
    <string name="dashboard_no_access_hint">Allow Screen Time to read app usage in Settings to see today\'s totals.</string>
    <!-- Dashboard: button that opens the usage-access screen in Settings. Verb phrase. -->
    <string name="dashboard_no_access_action">Open usage access</string>
    <!-- Dashboard: shown when usage access is granted but nothing has been used and no timer is set. -->
    <string name="dashboard_no_usage_title">Nothing used yet</string>
    <!-- Dashboard: explanation under the nothing-used row. -->
    <string name="dashboard_no_usage_hint">Apps you use today will appear here.</string>
    <!-- Dashboard: shown when the launchable app list came back empty (package visibility loss). -->
    <string name="dashboard_no_apps_title">No apps found</string>
    <!-- Dashboard: explanation under the no-apps row. -->
    <string name="dashboard_no_apps_hint">The app list came back empty, so there is nothing to show yet.</string>
    <!-- Dashboard: shown for an app with no timer set, and as the option that removes one. -->
    <string name="timer_none">No timer</string>

    <!-- Wind-down: single-letter day labels, Monday first, comma separated. -->
    <string name="day_initials">M,T,W,T,F,S,S</string>

    <!-- Wind-down: the main on/off switch. Verb phrase. -->
    <string name="winddown_enable">Use wind-down</string>
    <!-- Wind-down: explanation under the main switch. -->
    <string name="winddown_enable_hint">The screen goes quiet overnight: grayscale first, silence alongside.</string>
    <!-- Wind-down: schedule start row. Noun phrase. -->
    <string name="winddown_start">Starts at</string>
    <!-- Wind-down: schedule end row. Noun phrase. -->
    <string name="winddown_end">Ends at</string>
    <!-- Wind-down: heading above the effect toggles. Noun. -->
    <string name="winddown_effects">Effects</string>
    <!-- Wind-down: grayscale toggle. Noun. -->
    <string name="winddown_grayscale">Grayscale</string>
    <!-- Wind-down: grayscale explanation. -->
    <string name="winddown_grayscale_hint">Drain the color out of the screen overnight.</string>
    <!-- Wind-down: DND toggle. Noun phrase. -->
    <string name="winddown_dnd">Do Not Disturb</string>
    <!-- Wind-down: DND explanation. -->
    <string name="winddown_dnd_hint">Silence calls and notifications overnight. Needs policy access.</string>

    <!-- Shown in place of the app list while installed apps are still being read. -->
    <string name="apps_loading">Loading apps…</string>

    <!-- Dialog button that stores the chosen value. Verb. -->
    <string name="save">Save</string>
    <!-- Dialog button that discards the change. Verb. -->
    <string name="cancel">Cancel</string>
</resources>
