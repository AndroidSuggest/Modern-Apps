<?xml version="1.0" encoding="utf-8"?>
<!--
  Deny-all.

  This replaces an earlier rules file that included the whole sharedpref domain. That was
  wrong: every SharedPreferences file this app writes holds long-term secret material, so
  the previous policy uploaded live E2EE private keys to Google cloud backup.

  What is on disk and why none of it may be copied:

    shared_prefs/whatsapp_auth.xml     Noise X25519 static keypair, identity keypair,
                                       registrationId, signed pre-key + signature,
                                       advSecretKey, signed device identity. PLAINTEXT.
    shared_prefs/wa_appstate.xml       WhatsApp app-state sync keys, "key_<id>" -> base64
                                       key material. PLAINTEXT.
    shared_prefs/meta_auth.xml         Messenger/Instagram authenticated session blobs.
                                       PLAINTEXT.
    shared_prefs/secure_prefs.xml      SQLCipher passphrase wrapped by the non-exportable
                                       AndroidKeyStore key "db_no_auth_key".
    files/datastore_default.preferences_pb
                                       signal_auth_data (ACI/PNI identity keypairs,
                                       account password, masterKey, accountEntropyPool),
                                       signal_device_data, telegram_auth_data (MTProto
                                       authKey), gmessages_auth_data (ECDSA refresh key,
                                       tachyon token), gvoice_auth_data. PLAINTEXT JSON.
    databases/signal_protocol.db       signal_sessions, signal_identity_keys,
                                       signal_pre_keys, signal_signed_pre_keys,
                                       signal_kyber_pre_keys, signal_sender_keys,
                                       plus profileKey and group masterKey columns.
    databases/whatsapp_database        whatsapp_e2e_sessions, whatsapp_e2e_identities,
                                       whatsapp_e2e_pre_keys, whatsapp_e2e_signed_pre_keys,
                                       whatsapp_e2e_sender_keys, whatsapp_poll_secret.
    databases/messages.db,
    databases/meta_database            Message bodies and thread contents.
    (each of the above also has -wal/-shm/-journal sidecars and a transient _temp file,
     covered by the domain-wide exclude)
    root domain                        app_webview/ cookie and local-storage stores for
                                       the WhatsApp and Meta login WebViews, i.e. live
                                       authenticated sessions.

  Device transfer is denied as well, and that is deliberate rather than an oversight.
  Copying Double Ratchet state (session records, pre-keys, sender keys) onto a second
  device desynchronises the ratchet against the peer's chain: both installs advance from
  the same state, message keys are consumed twice, and messages become permanently
  undecryptable. Correct multi-device behaviour is to re-link the new device through each
  platform's own provisioning flow, which issues fresh keys. D2D also cannot carry the
  AndroidKeyStore key, so the SQLCipher databases would arrive unopenable regardless.

  There is no benign counterweight to include: this app persists no theme, sort-order or
  notification preference. Every artifact above is a secret or a message body.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
