<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- RCS ACS uses HTTP per GSMA RCC.14 spec:
         http://config.rcs.mnc<MNC>.mcc<MCC>.pub.3gppnetwork.org/ -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">3gppnetwork.org</domain>
        <domain includeSubdomains="true">pub.3gppnetwork.org</domain>
        <domain includeSubdomains="true">telephony.goog</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
        <domain includeSubdomains="true">google.com</domain>
    </domain-config>

    <!-- Hardened base: no cleartext except above domains, system roots only, no user CAs.
         Signal's pinned root is enforced in Java via CertPinning, not here. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
