// MAML v2 model container.
//
// Normative schema for `library/ml/MAML2_SPEC.md`. This file is the schema of
// record: the Rust loader and the Python converter both generate from it, so
// neither hand-writes the layout. See the spec for rationale; see
// `scripts/ml/maml_convert.py` for the v1 layout this replaces.
//
// Revision history
// Version 1: Initial version. SSA graph + weights, static shapes with
//            dim_params maxima, quantization as data, converter-repacked
//            layouts, prefill/decode entry points, KV-cache state tensors.
//
// IMPORTANT: All new members of tables, enums and unions must be added at the
// end to ensure backwards compatibility (LiteRT schema rule). The loader
// additionally enforces strict `version ==` until the first on-device ship
// (spec section 12.1); the append-at-end rule is what makes relaxing that
// possible later.

namespace maml2;

// This corresponds to the file format version (`Model.version`).
file_identifier "MAM2";
// File extension of any written files.
file_extension "maml";

// Initial opset: the op catalog in section 5.2 of the spec. New ops bump
// `Model.opset_version`; loaders reject newer than they implement.
enum Op : byte {
  Conv = 0,
  MatMul = 1,
  DepthwiseConv = 2,
  Embedding = 3,
  LayerNorm = 4,
  RmsNorm = 5,
  Attention = 6,
  AttentionDecode = 7,
  CacheWrite = 8,
  RotaryEmbedding = 9,
  Softmax = 10,
  Add = 11,
  Mul = 12,
  MulBroadcast = 13,
  AddBroadcast = 14,
  Affine = 15,
  GatedSwish = 16,
  Clamp = 17,
  MulScalar = 18,
  Softcap = 19,
  Resize = 20,
  MaxPool = 21,
  AvgPool = 22,
  GlobalAvgPool = 23,
  Concat = 24,
  View = 25,
  Constant = 26,
  Copy = 27,
  CustomOp = 28,
  // Transposed convolution (spec section 5.2): weights `[in_c, m/group, kh,
  // kw]`. Appended for the vision nets' learned upsamples; opset stays 1 —
  // the catalog grows together with its only loader until the first
  // on-device ship (spec section 12.1).
  ConvTranspose = 29,
  // A fused activation applied standalone, for values no convolution
  // produced (the gated feed-forward's epilogue). Carries `activation` like
  // the producer epilogues in section 5.2.
  Activate = 30
}

// Spec section 3.1. Integer dtypes are always quantised weights (section
// 3.3); activations and all computed tensors are float. No string, resource,
// or sparse support: the catalog has no op that needs them.
enum DType : byte {
  F16 = 0,
  F32 = 1,
  I32 = 2,
  U32 = 3,
  I8 = 4,
  I4 = 5,
  BF16 = 6
}

// Spec section 3.4. Declared per tensor; the converter repacks weights into
// whatever the kernels consume, so verbatim upload and optimal layout stop
// being in conflict.
enum Layout : byte {
  // Legacy row-major planes. Expressible, never optimal; loaders may refuse
  // to specialise pipelines for it.
  NCHW = 0,
  // Channel groups of 4 contiguous. Default for computed tensors: a channel
  // reduction is a vec4 load.
  CHANNEL_BLOCKED_4 = 1,
  // `[K, 1, d]` positions appended per step. KV-caches.
  POSITION_MAJOR = 2
}

// Spec section 3.3: quantization as data, not opcode variants.
enum QuantKind : byte {
  NONE = 0,
  // One fp16 scale per output channel along `quantized_dim`.
  PER_CHANNEL = 1,
  // One fp16 scale per `block_size` taps along `quantized_dim`.
  BLOCKWISE = 2
}

// Spec section 4: DEVICE is the default; HOST is gathered on the CPU (one row
// per step, never bound whole).
enum Placement : byte {
  DEVICE = 0,
  HOST = 1
}

// Spec section 6.2. The file embeds no cache contents: KV_CACHE declares
// capacity (`max_tokens` via dim_params), dtype, and POSITION_MAJOR layout.
enum StateKind : byte {
  NONE = 0,
  KV_CACHE = 1,
  // Survives across submits at a stable offset; the memory planner never
  // recycles it.
  PINNED = 2
}

enum BackendKind : byte {
  GPU = 0,
  CPU = 1
}

// `Softmax.mode` attribute values.
enum SoftmaxMode : byte {
  FULL = 0,
  CAUSAL = 1,
  PREFIX = 2
}

// `Resize.mode` attribute values.
enum ResizeMode : byte {
  BILINEAR_HALF_PIXEL = 0,
  NEAREST_ASYMMETRIC = 1
}

// Spec section 3.2: a sequence-like axis. `dims[axis]` is the baked maximum;
// the live length `<= max` arrives per submit as a step uniform. Rank is
// fixed; only named axes vary, and only with an explicit max.
table DimParam {
  axis: uint;
  symbol: string;
  max: int;
}

// Spec section 3.3. Inline struct: scales live as ordinary tensors elsewhere
// in `Model.tensors`, so this carries indices, not bytes.
struct Quantization {
  kind: QuantKind;
  // Index into `Model.tensors`. Always fp16. -1 when kind == NONE.
  scale_tensor: int;
  // -1 means symmetric (zero point 0). Symmetric-only is enforced at
  // validation; the field exists for schema completeness.
  zero_point: int;
  // Which axis scales run along (PER_CHANNEL), or the contraction axis
  // (BLOCKWISE).
  quantized_dim: int;
  // Taps per scale for BLOCKWISE. v1's 32-wide I4 blocks carry over.
  block_size: int;
}

table Tensor {
  // Debug and error messages only. Never resolved by name at load.
  name: string;
  dtype: DType;
  // Static shape, all values > 0. A promise the loader may bake into
  // compiled pipelines.
  dims: [int];
  dim_params: [DimParam];
  layout: Layout;
  quantization: Quantization;
  // Index into `Model.buffers`, or -1 for computed/state tensors.
  buffer: int;
  // Byte offset within the buffer. Must be 16-aligned.
  buffer_offset: ulong;
  // Logical elements; cross-checked against the dims product (with packed
  // byte math for I4).
  elem_count: ulong;
  placement: Placement;
  state: StateKind;
}

table Buffer {
  // 16-aligned weight bytes. One buffer per file in practice; many allowed.
  // Uploaded verbatim to one VkBuffer with chunked copies straight from the
  // mmap: peak host cost one chunk, never a second full allocation.
  data: [ubyte] (force_align: 16);
}

// Attribute value wrappers. FlatBuffers unions hold tables only, so each
// scalar/vector kind gets one.
table AttrInt { value: int; }
table AttrInts { value: [int]; }
table AttrFloat { value: float; }
table AttrFloats { value: [float]; }
table AttrBool { value: bool; }
table AttrString { value: string; }

union AttrValue {
  AttrInt,
  AttrInts,
  AttrFloat,
  AttrFloats,
  AttrBool,
  AttrString
}

table Attribute {
  name: string;
  value: AttrValue;
}

table Node {
  op: Op;
  // Tensor indices. The file order of nodes is topological and IS the
  // schedule seed.
  inputs: [int];
  // Usually one.
  outputs: [int];
  // Typed attributes, op-specific (spec section 5.2). Epilogue fusion rides
  // here: `activation`, `res`, `shift` on the producer.
  attrs: [Attribute];
  // CustomOp-only opaque bytes. Must be empty for every other op; validated.
  payload: [ubyte];
}

table Graph {
  // "prefill", "decode_step", "encode", ...
  name: string;
  // Indices into `Model.tensors` forming this graph's SSA scope.
  tensors: [int];
  nodes: [Node];
  // Tensor indices, declaration order = binding order.
  inputs: [int];
  outputs: [int];
}

table EntryPoint {
  // "encode" | "prefill" | "decode_step" | "image" | "text" ...
  name: string;
  graph: uint;
  // Roles, e.g. ["tokens", "images", "mel"]. Bind positionally to
  // `Graph.inputs`.
  inputs: [string];
  // Live values per submit, e.g. ["prefix_len", "window_start"].
  step_uniforms: [string];
}

// Spec section 6.3. Advisory: the loader may override, but the default path
// must match what the converter validated parity against.
table BackendHint {
  // Names an `EntryPoint.name`.
  entry_point: string;
  preferred: BackendKind;
  fallback: BackendKind;
}

// Free-form metadata (tokenizer asset name, license, calibration note, and
// `parity_sha256`). Never load-bearing.
table KeyValue {
  key: string;
  value: string;
}

table Model {
  // File format version. The loader rejects mismatch: unequal means reject.
  version: uint;
  // Op catalog version (spec section 5.3). Loaders reject newer than
  // implemented.
  opset_version: uint;
  // Semver floor for the loader, e.g. "2.3.0".
  runtime_min_version: string;
  // What wrote this file, for bisection.
  converter_version: string;
  // Upstream artifact hash. Traceability, as v1.
  source_sha256: [ubyte];
  // SHA-256 over the canonical op/edge/attr sequence (spec section 9.2).
  // Replaces v1's graph_id integer.
  graph_digest: [ubyte];
  // Human-readable, e.g. "supertonic-sampler fp16".
  description: string;
  backends: [BackendHint];
  // Every value in every graph, weights and computed alike.
  tensors: [Tensor];
  // Weight bytes. Computed tensors reference no buffer.
  buffers: [Buffer];
  // Usually one; LLM text models ship prefill + decode sharing tensors.
  graphs: [Graph];
  // Named signatures over graphs.
  entry_points: [EntryPoint];
  metadata: [KeyValue];
}

root_type Model;
