<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts/calendar/health sync client. Overrides the permissive default in the shared
     :library module.

     Storage audit:
       file  datastore_default.preferences_pb   One shared DataStore holding everything:
             - tok_oauth_<account>  OAuth access + refresh tokens (TokenStore)
             - tok_dav_<account>    CalDAV/CardDAV base URL, username and password, including
                                    iCloud app-specific passwords
             - the AccountConfig list (account names, providers, endpoints, enabled data types)
             - global settings: global_interval_minutes, wifi_only, conflict_policy
       No database, no SharedPreferences, no app-private files or caches. Synced contacts,
       calendars and health records land in the system providers, not in app storage.

     Secrets are AES-GCM sealed under an AndroidKeyStore key that cannot leave the device, so a
     cloud copy would be undecryptable ciphertext — but shipping a user's refresh tokens and
     DAV passwords to Google's servers at all is not a trade worth making, and they are not
     separable from the settings because they share one DataStore file. Cloud backup is denied.
     Device transfer keeps the file so account configuration and settings survive a migration;
     the sealed blobs will fail to decrypt on the new device and TokenStore.load() already
     returns null in that case, which re-prompts for sign-in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore_default.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
