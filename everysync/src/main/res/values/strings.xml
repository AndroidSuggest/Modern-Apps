<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- App name displayed in launcher and system Accounts settings -->
    <string name="app_name" translatable="false">EverySync</string>

    <!-- AccountsScreen: TopAppBar title for accounts list home screen -->
    <string name="accounts_title">EverySync</string>
    <!-- AccountsScreen empty state / AccountDetail fallback: Message when no accounts added yet. Includes + hint -->
    <string name="no_accounts">No accounts yet. Tap + to add one.</string>
    <!-- AccountDetailScreen: Button to trigger immediate sync for this account. Verb phrase -->
    <string name="sync_now">Sync now</string>
    <!-- AccountsScreen: Row status showing sync currently in progress -->
    <string name="syncing">Syncing…</string>
    <!-- AccountsScreen: Row showing last sync time. %1$s = formatted date/time -->
    <string name="last_synced">Last synced: <xliff:g id="date" example="Today 10:30 AM">%1$s</xliff:g></string>
    <!-- AccountsScreen: Row status when account never synced before -->
    <string name="never_synced">Never synced</string>

    <!-- AddAccountScreen: TopAppBar title for provider chooser screen -->
    <string name="add_account_title">Add account</string>

    <!-- AccountDetailScreen: Toggle label for contacts sync capability. Verb phrase -->
    <string name="sync_contacts">Sync contacts</string>
    <!-- AccountDetailScreen: Toggle label for calendar sync capability. Verb phrase -->
    <string name="sync_calendar">Sync calendars</string>
    <!-- AccountDetailScreen: Toggle label for passwords vault sync capability. Verb phrase -->
    <string name="sync_passwords">Sync passwords</string>
    <!-- AccountDetailScreen: Toggle label for notes vault sync capability. Verb phrase -->
    <string name="sync_notes">Sync notes</string>
    <!-- AccountDetailScreen: Toggle label for todos vault sync capability. Verb phrase -->
    <string name="sync_todos">Sync todos</string>
    <!-- AccountDetailScreen: Destructive button to remove account from app. Verb phrase -->
    <string name="remove_account">Remove account</string>
    <!-- VaultSharingSection: Section header over personal E2EE vaults. Noun, plural -->
    <string name="vaults_title">Personal vaults</string>
    <!-- VaultSharingSection: Label for the new-vault title field. Noun phrase -->
    <string name="vault_new_title">New vault title</string>
    <!-- VaultSharingSection: Button creating a contacts vault. Verb + noun -->
    <string name="vault_create_contacts">Contacts vault</string>
    <!-- VaultSharingSection: Button creating a calendar vault. Verb + noun -->
    <string name="vault_create_calendar">Calendar vault</string>
    <!-- VaultSharingSection: Empty state when no vaults exist yet. Full sentence -->
    <string name="vaults_empty">No vaults yet. Name one above to create an end-to-end encrypted vault.</string>
    <!-- VaultRow: Button opening the share dialog. Verb -->
    <string name="vault_share">Share</string>
    <!-- VaultSharingSection: Chooser title for the share-link sheet. Noun phrase -->
    <string name="share_link_chooser">Share vault link</string>
    <!-- Vault flow: Snackbar after a sealed invite is delivered. Short confirmation -->
    <string name="invite_sent">Invite sent</string>
    <!-- Vault flow: Snackbar when sealing or delivering an invite fails. Short error -->
    <string name="invite_failed">Could not send invite</string>
    <!-- Vault flow: Snackbar after creating a vault. Short confirmation -->
    <string name="vault_created">Vault created</string>
    <!-- Vault flow: Snackbar when vault creation fails. Short error -->
    <string name="vault_create_failed">Could not create vault</string>
    <!-- Vault flow: Snackbar when the safety code cannot be computed. Short error -->
    <string name="safety_code_failed">Could not compute safety code</string>
    <!-- Join-link flow: Snackbar while the join request sends. Verb, progressive -->
    <string name="join_request_sending">Sending join request…</string>
    <!-- Join-link flow: Snackbar after the join request is delivered. Short confirmation -->
    <string name="join_request_sent">Join request sent</string>
    <!-- Join-link flow: Snackbar when the join request fails. Short error -->
    <string name="join_request_failed">Could not send join request</string>

    <!-- SettingsScreen: TopAppBar title for global settings -->
    <string name="settings_title">Settings</string>
    <!-- SettingsScreen: Label for global sync interval in minutes field -->
    <string name="global_interval">Sync interval (minutes)</string>
    <!-- SettingsScreen: Switch label to restrict syncing to Wi-Fi only -->
    <string name="wifi_only">Sync on Wi-Fi only</string>
    <!-- SettingsScreen: Section header for conflict resolution policy radios -->
    <string name="conflict_policy">Conflict resolution</string>
    <!-- SettingsScreen conflict option: Last writer wins strategy. Phrase -->
    <string name="conflict_lww">Last writer wins</string>
    <!-- SettingsScreen conflict option: Prefer data from server when conflict. Verb phrase -->
    <string name="conflict_remote">Prefer server</string>
    <!-- SettingsScreen conflict option: Prefer local device data when conflict. Verb phrase -->
    <string name="conflict_local">Prefer device</string>

    <!-- AccountsScreen PermissionsChecker: Rationale text explaining why contacts/calendar permission needed -->
    <string name="need_permissions">EverySync needs contacts and calendar access to sync your vaults.</string>

    <!-- SyncErrorBanner: user-facing text for stable abort codes (see VaultSyncAbort). No key material, no contents -->
    <string name="sync_error_pull_failed">Could not reach the sync server. Nothing was changed — will retry automatically.</string>
    <string name="sync_error_undecryptable">The server data could not be unlocked with this vault key. Nothing was changed — check the vault key epoch.</string>
    <string name="sync_error_local_read">Could not read local data (the app may be locked). Nothing was changed — will retry automatically.</string>
    <string name="sync_error_relay_unavailable">The sync server is unavailable. Nothing was changed — will retry automatically.</string>
    <string name="sync_error_hint">Sync paused safely: no data was deleted. It resumes on the next sync.</string>

    <!-- SnapshotSection: header + description for daily encrypted recovery snapshots -->
    <string name="snapshots_title">Recovery snapshots</string>
    <string name="snapshots_description">One encrypted snapshot per day, kept for 30 days. Restoring replays a day through sync — newer edits still win where they conflict.</string>
    <!-- SnapshotSection row: %1$s = vault type, %2$d = record count -->
    <string name="snapshot_row">%1$s · <xliff:g id="count" example="42">%2$d</xliff:g> records</string>
    <string name="snapshot_restore">Restore</string>
    <string name="snapshot_take_now">Back up now</string>
    <string name="snapshots_empty">No snapshots yet. Snapshots are taken daily and before sync is turned off.</string>
    <string name="snapshot_restore_title">Restore snapshot?</string>
    <!-- SnapshotSection restore confirm: %1$s = date, %2$s = vault type -->
    <string name="snapshot_restore_confirm">Replay <xliff:g id="date" example="Oct 13, 2026">%1$s</xliff:g> (<xliff:g id="type" example="passwords">%2$s</xliff:g>) through sync? Newer edits still win where they conflict.</string>
    <!-- ViewModel announce: %1$d = restored record count -->
    <string name="snapshot_restored">Restored <xliff:g id="count" example="42">%1$d</xliff:g> records. Reconciling with the server…</string>
    <string name="snapshot_restore_failed">Could not restore that snapshot.</string>
</resources>
