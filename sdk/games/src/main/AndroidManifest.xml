<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The hub's signature permissions are declared by each consuming game, not here.
         :library depends on :sdk:games and every app depends on :library, so declaring
         them in this manifest would make all ~50 apps in the repo request them. -->

    <queries>
        <package android:name="com.vayunmathur.games.hub" />
        <package android:name="com.vayunmathur.games" />
    </queries>
</manifest>
